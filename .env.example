# Public — safe to expose to the browser. Used by the anon client, which is
# always bound by RLS policies (see supabase/setup_all.sql).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used to build the email-confirmation redirect link. Set to your deployed
# Vercel URL in production, http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET — server-side only. Never import this into any file that can end up
# in a client bundle. Bypasses RLS entirely. Used only by:
#  - scripts/create-admin.ts (one-off admin bootstrap, run locally/CI, not at request time)
#  - src/lib/supabase/admin.ts (server-only helper; import only from server
#    components, server actions, or route handlers — never from "use client" files)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by scripts/create-admin.ts for the initial admin account's TEMPORARY
# password. Leave empty to generate a random one (printed once). Weak values
# such as the old "admin12345" are refused. The admin must change it on first
# login — the database withholds admin power until they do (0026).
INITIAL_ADMIN_EMAIL=admin@cdti.ac.th
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=CDTI System Administrator
